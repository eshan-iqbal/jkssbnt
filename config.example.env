# JKSSB Monitor Configuration
# Copy this file to config.env and fill in your credentials

# ============================================
# TELEGRAM CONFIGURATION (Required for Telegram notifications)
# ============================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (get from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# Enable email notifications (true/false)
EMAIL_ENABLED=false

# SMTP server settings (Gmail example)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your email credentials
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Email to send notifications to
EMAIL_TO=recipient@example.com

# Optional: Custom from email (defaults to SMTP_USERNAME)
# SMTP_FROM=noreply@example.com

# ============================================
# WHATSAPP CONFIGURATION (Optional - requires Twilio)
# ============================================
# Twilio Account SID and Auth Token
# Get from: https://console.twilio.com
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token

# WhatsApp numbers (must include 'whatsapp:' prefix)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+919876543210

# ============================================
# MONITORING CONFIGURATION
# ============================================
# Run in continuous mode (true) or single check mode (false)
# For cron jobs, use false. For Docker/always-on servers, use true
CONTINUOUS_MODE=false

# Interval between checks in seconds (default: 1800 = 30 minutes)
# Only used when CONTINUOUS_MODE=true
CHECK_INTERVAL=1800
